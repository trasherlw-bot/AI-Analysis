# cp .env.example .env   then edit with: sudo nano .env
# Rules: no quotes, no spaces around "=", avoid the characters  $  #  in the password.

# HelpDeskEddy: the subdomain in  https://<this>.helpdeskeddy.com
HDE_DOMAIN=kse
HDE_EMAIL=
HDE_API_KEY=

# Password for the web page (at least 8 characters, long and random is best)
APP_PASSWORD=

# Keep false while the site is http://. Set true after HTTPS is enabled.
COOKIE_SECURE=false

# Numbers from:  id -u deploy   and   id -g deploy
APP_UID=1000
APP_GID=1000

# true = also mask personal names (needs ~300 MB RAM extra while running). See README.
INSTALL_NATASHA=false
